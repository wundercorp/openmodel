import {
  CapacityContractError,
  applyProviderNodeHeartbeat,
  applyUsageReport,
  calculateEffectiveAvailableGpuCount,
  createEarning,
  createPayout,
  createReservation,
  materializeEarningStatus,
  roundMoney,
  sanitizeProviderNode,
  summarizeEarnings,
  transitionPayout,
  transitionReservation,
  validateGpuCapacitySubmission,
  validatePayoutProfile,
  validateProviderNodeSubmission
} from "../../../packages/capacity-core/src/index.js";

interface Env {
  AUTH_ISSUER: string;
  AUTH_AUDIENCE: string;
  ALLOWED_ORIGINS: string;
  GATEWAY_REGISTRY?: KVNamespace;
  GPU_CAPACITY_REGISTRY?: KVNamespace;
  HYPERSCALER_SUBJECTS?: string;
  CAPACITY_HEARTBEAT_MAX_AGE_SECONDS?: string;
  CAPACITY_ASSIGNMENT_TIMEOUT_SECONDS?: string;
  CAPACITY_EARNINGS_HOLD_SECONDS?: string;
  CAPACITY_MINIMUM_PAYOUT_AMOUNT?: string;
  CAPACITY_PLATFORM_FEE_BPS?: string;
  CAPACITY_ALLOW_EVENTUALLY_CONSISTENT_ALLOCATIONS?: string;
}

interface JwtHeader { alg: string; kid: string; typ?: string; }
interface JwtPayload {
  iss: string;
  aud?: string | string[];
  client_id?: string;
  azp?: string;
  token_use?: string;
  username?: string;
  "cognito:username"?: string;
  "cognito:groups"?: string[];
  sub: string;
  exp: number;
  nbf?: number;
  iat?: number;
  email?: string;
  name?: string;
  scope?: string;
  permissions?: string[];
  [key: string]: unknown;
}
interface JwkWithKid extends JsonWebKey { kid?: string; }
interface OidcMetadata { issuer: string; jwks_uri: string; }

type CapacityRecord = Record<string, any>;

const metadataCache = new Map<string, { expiresAt: number; value: OidcMetadata }>();
const jwksCache = new Map<string, { expiresAt: number; value: JwkWithKid[] }>();
const gpuCapacityPath = "/v1/capacity/gpu";
const providerNodesPath = "/v1/provider/nodes";
const providerReservationsPath = "/v1/provider/reservations";
const providerEarningsPath = "/v1/provider/earnings";
const providerPayoutProfilePath = "/v1/provider/payout-profile";
const providerPayoutsPath = "/v1/provider/payouts";
const hyperscalerReservationsPath = "/v1/hyperscaler/reservations";
const hyperscalerPayoutsPath = "/v1/hyperscaler/payouts";
const hyperscalerPayoutProfilesPath = "/v1/hyperscaler/payout-profiles";

export default {
  async fetch(request: Request, env: Env): Promise<Response> {
    const corsHeaders = createCorsHeaders(request.headers.get("origin"), env.ALLOWED_ORIGINS);
    if (request.method === "OPTIONS") return new Response(null, { status: 204, headers: corsHeaders });
    const path = normalizePath(new URL(request.url).pathname);

    try {
      if (request.method === "GET" && path === "/health") {
        return json({
          status: "ok",
          service: "openmodel-cloud",
          apiAliases: ["https://api.openmodel.sh", "https://api.walton.bot"],
          capacityControlPlane: "hyperscaler-master-v1"
        }, 200, corsHeaders);
      }

      if (request.method === "GET" && path === "/v1/gateways") {
        return json({ data: await listGateways(env) }, 200, corsHeaders);
      }

      if (request.method === "GET" && path === gpuCapacityPath) {
        const records = await listCapacityRecords(env);
        const nodesById = new Map(records.filter((record) => record.recordType === "GPU_PROVIDER_NODE").map((node) => [node.id, node]));
        const listings = records
          .filter((record) => record.recordType === "GPU_CAPACITY" && record.status === "PUBLISHED")
          .map((listing) => projectPublicListing(listing, nodesById.get(listing.workerNodeId), env))
          .filter(Boolean);
        return json({
          data: listings,
          meta: {
            canonicalApi: "https://api.openmodel.sh",
            aliasApi: "https://api.walton.bot",
            architecture: "hyperscaler-master/provider-worker",
            heartbeatMaximumAgeSeconds: heartbeatMaximumAgeSeconds(env),
            storageConsistency: "Cloudflare KV is eventually consistent; use the AWS control plane for strict transactional allocation."
          }
        }, 200, corsHeaders);
      }

      const nodeRoute = matchNodeControlRoute(path);
      if (nodeRoute) {
        const node = await authenticateNode(request.headers.get("authorization"), nodeRoute.nodeId, env);
        return await handleNodeControlRoute(request, nodeRoute, node, env, corsHeaders);
      }

      const user = await authenticate(request, env);

      if (request.method === "GET" && path === "/v1/me") {
        return json({
          id: user.sub,
          email: user.email,
          name: user.name,
          username: user.username ?? user["cognito:username"],
          scope: user.scope,
          permissions: user.permissions ?? [],
          groups: Array.isArray(user["cognito:groups"]) ? user["cognito:groups"] : [],
          clientId: user.client_id ?? user.azp ?? (Array.isArray(user.aud) ? user.aud[0] : user.aud),
          capacityRoles: { provider: true, hyperscalerMaster: hasHyperscalerPermission(user, env) }
        }, 200, corsHeaders);
      }

      if (request.method === "POST" && path === "/v1/gateways") {
        requirePermission(user, "gateways:write");
        const gateway = validateGatewaySubmission(await request.json());
        if (!env.GATEWAY_REGISTRY) throw new HttpError(503, "Gateway registry storage is not configured.");
        await env.GATEWAY_REGISTRY.put(`gateway:${gateway.id}`, JSON.stringify(gateway));
        return json({ data: gateway }, 201, corsHeaders);
      }

      if (path === providerNodesPath || path.startsWith(`${providerNodesPath}/`)) {
        return await handleProviderNodesRoute(request, path, user, env, corsHeaders);
      }

      if (path === providerReservationsPath) {
        if (request.method !== "GET") throw new HttpError(405, "Method not allowed.");
        const reservations = (await listRecordsByType(env, "GPU_RESERVATION")).filter((reservation) => reservation.providerId === user.sub).map(projectProviderReservation);
        return json({ data: reservations }, 200, corsHeaders);
      }

      if (path === providerEarningsPath) {
        if (request.method !== "GET") throw new HttpError(405, "Method not allowed.");
        const stored = (await listRecordsByType(env, "GPU_EARNING")).filter((earning) => earning.providerId === user.sub);
        const summary = summarizeEarnings(stored);
        await persistMaterializedEarnings(env, stored, summary.earnings);
        return json({ data: summary.earnings, totals: summary.totals }, 200, corsHeaders);
      }

      if (path === providerPayoutProfilePath) {
        return await handleProviderPayoutProfileRoute(request, user, env, corsHeaders);
      }

      if (path === providerPayoutsPath) {
        return await handleProviderPayoutsRoute(request, user, env, corsHeaders);
      }

      if (path === hyperscalerReservationsPath || path.startsWith(`${hyperscalerReservationsPath}/`)) {
        requireHyperscaler(user, env);
        return await handleHyperscalerReservationsRoute(request, path, user, env, corsHeaders);
      }

      if (path === hyperscalerPayoutsPath || path.startsWith(`${hyperscalerPayoutsPath}/`)) {
        requireHyperscaler(user, env, "capacity:settle");
        return await handleHyperscalerPayoutsRoute(request, path, env, corsHeaders);
      }

      if (path.startsWith(`${hyperscalerPayoutProfilesPath}/`)) {
        requireHyperscaler(user, env, "capacity:settle");
        return await handleHyperscalerPayoutProfileRoute(request, path, env, corsHeaders);
      }

      if (request.method === "GET" && path === `${gpuCapacityPath}/mine`) {
        const listings = await listRecordsByType(env, "GPU_CAPACITY");
        return json({ data: listings.filter((listing) => listing.ownerId === user.sub) }, 200, corsHeaders);
      }

      if (request.method === "POST" && path === gpuCapacityPath) {
        const body = await request.json<Record<string, unknown>>();
        await assertWorkerListingCompatible(env, body, body.workerNodeId, user.sub);
        const listing = validateGpuCapacitySubmission(body, {
          id: crypto.randomUUID(),
          ownerId: user.sub,
          ownerDisplayName: userDisplayName(user),
          status: body.publish === true ? "PUBLISHED" : "DRAFT"
        }, { platformFeeBps: platformFeeBps(env) });
        await saveRecord(env, listing, true);
        return json({ data: listing }, 201, corsHeaders);
      }

      const listingRoute = matchGpuCapacityListingRoute(path);
      if (listingRoute) return await handleGpuListingRoute(request, listingRoute, user, env, corsHeaders);

      return json({ error: "Not found", code: "NOT_FOUND" }, 404, corsHeaders);
    } catch (error) {
      const status = error instanceof HttpError || error instanceof CapacityContractError ? error.status : 500;
      const message = error instanceof Error ? error.message : "Internal error";
      const code = (error as { code?: string })?.code ?? (status === 500 ? "INTERNAL_ERROR" : "REQUEST_ERROR");
      return json({ error: message, code }, status, corsHeaders);
    }
  }
};

async function handleProviderNodesRoute(request: Request, path: string, user: JwtPayload, env: Env, corsHeaders: HeadersInit) {
  if (path === providerNodesPath) {
    if (request.method === "GET") {
      const nodes = (await listRecordsByType(env, "GPU_PROVIDER_NODE")).filter((node) => node.ownerId === user.sub).map(sanitizeProviderNode);
      return json({ data: nodes }, 200, corsHeaders);
    }
    if (request.method === "POST") {
      const body = await request.json<Record<string, unknown>>();
      const id = `node_${crypto.randomUUID()}`;
      const credential = `${id}.${createSecret()}`;
      const node = validateProviderNodeSubmission(body, {
        id,
        ownerId: user.sub,
        ownerDisplayName: userDisplayName(user),
        tokenHash: await sha256Hex(credential),
        tokenLastFour: credential.slice(-4)
      });
      await saveRecord(env, node, true);
      return json({ data: sanitizeProviderNode(node), nodeToken: credential }, 201, corsHeaders);
    }
    throw new HttpError(405, "Method not allowed.");
  }

  const match = path.match(/^\/v1\/provider\/nodes\/([^/]+)(?:\/(rotate-token|enable|drain|disable))?$/);
  if (!match) throw new HttpError(404, "Provider node route was not found.");
  const node = await readRecord(env, decodeURIComponent(match[1]));
  if (!node || node.recordType !== "GPU_PROVIDER_NODE") throw new HttpError(404, "Provider node was not found.");
  if (node.ownerId !== user.sub) throw new HttpError(403, "Only the node owner can manage this provider node.");
  const action = match[2];
  if (request.method === "GET" && !action) return json({ data: sanitizeProviderNode(node) }, 200, corsHeaders);
  if (request.method !== "POST" || !action) throw new HttpError(405, "Method not allowed.");

  if (action === "rotate-token") {
    const credential = `${node.id}.${createSecret()}`;
    const updated = { ...node, tokenHash: await sha256Hex(credential), tokenLastFour: credential.slice(-4), tokenCreatedAt: new Date().toISOString(), status: "ACTIVE", updatedAt: new Date().toISOString(), revision: Number(node.revision ?? 0) + 1 };
    await saveRecordWithRevision(env, updated, node.revision);
    return json({ data: sanitizeProviderNode(updated), nodeToken: credential }, 200, corsHeaders);
  }
  if (action === "disable" && await hasActiveReservationsForNode(env, node.id)) {
    throw new HttpError(409, "Drain the node and finish or cancel its active assignments before disabling it.");
  }
  const nextStatus = action === "enable" ? "ACTIVE" : action === "drain" ? "DRAINING" : "DISABLED";
  const updated = { ...node, status: nextStatus, healthStatus: action === "disable" ? "OFFLINE" : node.healthStatus, updatedAt: new Date().toISOString(), revision: Number(node.revision ?? 0) + 1 };
  await saveRecordWithRevision(env, updated, node.revision);
  return json({ data: sanitizeProviderNode(updated) }, 200, corsHeaders);
}

async function handleNodeControlRoute(request: Request, route: ReturnType<typeof matchNodeControlRoute> & {}, node: CapacityRecord, env: Env, corsHeaders: HeadersInit) {
  if (route.action === "heartbeat") {
    if (request.method !== "POST") throw new HttpError(405, "Method not allowed.");
    const body = await readOptionalJson(request);
    const updatedNode = applyProviderNodeHeartbeat(node, body);
    await saveRecordWithRevision(env, updatedNode, node.revision);
    await synchronizeListingsFromNode(env, updatedNode);
    return json({ data: sanitizeProviderNode(updatedNode) }, 200, corsHeaders);
  }
  if (route.action === "assignments" && !route.reservationId) {
    if (request.method !== "GET") throw new HttpError(405, "Method not allowed.");
    await expireStaleAssignmentsForNode(env, node.id);
    const reservations = (await listRecordsByType(env, "GPU_RESERVATION")).filter((reservation) => reservation.nodeId === node.id && ["ASSIGNED", "ACCEPTED", "RUNNING"].includes(reservation.status));
    return json({ data: reservations.map(projectNodeAssignment) }, 200, corsHeaders);
  }
  if (route.action === "assignments" && route.reservationId && route.assignmentAction) {
    if (request.method !== "POST") throw new HttpError(405, "Method not allowed.");
    const reservation = await readRecord(env, route.reservationId);
    if (!reservation || reservation.recordType !== "GPU_RESERVATION" || reservation.nodeId !== node.id) throw new HttpError(404, "Assignment was not found for this node.");
    const body = await readOptionalJson(request);
    if (route.assignmentAction === "usage") {
      const updated = applyUsageReport(reservation, body);
      await saveRecordWithRevision(env, updated, reservation.revision);
      return json({ data: updated }, 200, corsHeaders);
    }
    const updated = transitionReservation(reservation, route.assignmentAction, body);
    let responseReservation = updated;
    if (["COMPLETED", "FAILED"].includes(updated.status)) responseReservation = await finalizeReservation(env, reservation, updated);
    else await saveRecordWithRevision(env, updated, reservation.revision);
    return json({ data: responseReservation }, 200, corsHeaders);
  }
  throw new HttpError(404, "Node control route was not found.");
}

async function handleHyperscalerReservationsRoute(request: Request, path: string, user: JwtPayload, env: Env, corsHeaders: HeadersInit) {
  if (path === `${hyperscalerReservationsPath}/sweep`) {
    if (request.method !== "POST") throw new HttpError(405, "Method not allowed.");
    requireEventuallyConsistentAllocationOptIn(env);
    return json({ data: await expireAllStaleAssignments(env) }, 200, corsHeaders);
  }
  if (path === hyperscalerReservationsPath) {
    if (request.method === "GET") return json({ data: await listRecordsByType(env, "GPU_RESERVATION") }, 200, corsHeaders);
    if (request.method === "POST") {
      requireEventuallyConsistentAllocationOptIn(env);
      const body = await request.json<Record<string, unknown>>();
      if (body.clientRequestId) {
        const existing = (await listRecordsByType(env, "GPU_RESERVATION")).find((reservation) => reservation.buyerId === user.sub && reservation.clientRequestId === String(body.clientRequestId));
        if (existing) return json({ data: existing, idempotent: true }, 200, corsHeaders);
      }
      const listing = await readRecord(env, String(body.listingId ?? ""));
      const node = listing?.workerNodeId ? await readRecord(env, listing.workerNodeId) : undefined;
      const reservationId = body.clientRequestId
        ? `reservation_${(await sha256Hex(`reservation:${user.sub}:${String(body.clientRequestId)}`)).slice(0, 48)}`
        : `reservation_${crypto.randomUUID()}`;
      const reservation = createReservation(body, listing, node, user, { id: reservationId }, {
        maximumHeartbeatAgeSeconds: heartbeatMaximumAgeSeconds(env),
        assignmentTimeoutSeconds: assignmentTimeoutSeconds(env)
      });
      try {
        await reserveCapacity(env, listing, reservation);
      } catch (error) {
        if (body.clientRequestId) {
          const idempotentReservation = await readRecord(env, reservationId);
          if (idempotentReservation?.buyerId === user.sub && idempotentReservation?.clientRequestId === String(body.clientRequestId)) return json({ data: idempotentReservation, idempotent: true }, 200, corsHeaders);
        }
        throw error;
      }
      return json({ data: reservation }, 201, corsHeaders);
    }
    throw new HttpError(405, "Method not allowed.");
  }
  const match = path.match(/^\/v1\/hyperscaler\/reservations\/([^/]+)(?:\/(cancel|dispute|expire))?$/);
  if (!match) throw new HttpError(404, "Hyperscaler reservation route was not found.");
  const reservation = await readRecord(env, decodeURIComponent(match[1]));
  if (!reservation || reservation.recordType !== "GPU_RESERVATION") throw new HttpError(404, "Reservation was not found.");
  const action = match[2];
  if (request.method === "GET" && !action) return json({ data: reservation }, 200, corsHeaders);
  if (request.method === "POST" && action) {
    requireEventuallyConsistentAllocationOptIn(env);
    const updated = transitionReservation(reservation, action, await readOptionalJson(request));
    let responseReservation = updated;
    if (updated.status === "DISPUTED") responseReservation = await persistDisputedReservation(env, reservation, updated);
    else if (["CANCELLED", "EXPIRED"].includes(updated.status)) responseReservation = await finalizeReservation(env, reservation, updated, { createEarningRecord: false });
    else await saveRecordWithRevision(env, updated, reservation.revision);
    return json({ data: responseReservation }, 200, corsHeaders);
  }
  throw new HttpError(405, "Method not allowed.");
}

async function handleProviderPayoutProfileRoute(request: Request, user: JwtPayload, env: Env, corsHeaders: HeadersInit) {
  const id = `payout-profile:${user.sub}`;
  const existing = await readRecord(env, id);
  if (request.method === "GET") return json({ data: existing ?? null }, 200, corsHeaders);
  if (request.method === "PUT") {
    const body = await request.json<Record<string, unknown>>();
    const profile = validatePayoutProfile(body, user.sub, existing);
    if (existing) await saveRecordWithRevision(env, profile, existing.revision);
    else await saveRecord(env, profile, true);
    return json({ data: profile }, existing ? 200 : 201, corsHeaders);
  }
  throw new HttpError(405, "Method not allowed.");
}

async function handleProviderPayoutsRoute(request: Request, user: JwtPayload, env: Env, corsHeaders: HeadersInit) {
  if (request.method === "GET") {
    const payouts = (await listRecordsByType(env, "GPU_PAYOUT")).filter((payout) => payout.providerId === user.sub);
    return json({ data: payouts }, 200, corsHeaders);
  }
  if (request.method === "POST") {
    requireEventuallyConsistentAllocationOptIn(env);
    const body = await readOptionalJson(request);
    const profile = await readRecord(env, `payout-profile:${user.sub}`);
    const stored = (await listRecordsByType(env, "GPU_EARNING")).filter((earning) => earning.providerId === user.sub);
    const materialized = stored.map((earning) => materializeEarningStatus(earning));
    await persistMaterializedEarnings(env, stored, materialized);
    const result = createPayout(body, profile, materialized, { id: `payout_${crypto.randomUUID()}` }, { minimumPayoutAmount: minimumPayoutAmount(env) });
    if (result.earnings.length > 90) throw new HttpError(409, "A payout can include at most 90 earning records.");
    await saveRecord(env, result.payout, true);
    const updatedEarningIds: string[] = [];
    try {
      for (const earning of result.earnings as CapacityRecord[]) {
        await saveRecordWithRevision(env, earning, Number(earning.revision ?? 1) - 1);
        updatedEarningIds.push(earning.id);
      }
    } catch (error) {
      const originalsById = new Map(materialized.map((earning) => [earning.id, earning]));
      await Promise.allSettled(updatedEarningIds.map(async (earningId) => {
        const current = await readRecord(env, earningId);
        const original = originalsById.get(earningId);
        if (current && original && current.payoutId === result.payout.id) await saveRecordWithRevision(env, original, current.revision);
      }));
      await deleteRecord(env, result.payout.id);
      throw error;
    }
    return json({ data: result.payout }, 201, corsHeaders);
  }
  throw new HttpError(405, "Method not allowed.");
}

async function handleHyperscalerPayoutsRoute(request: Request, path: string, env: Env, corsHeaders: HeadersInit) {
  if (request.method === "POST") requireEventuallyConsistentAllocationOptIn(env);
  if (path === hyperscalerPayoutsPath) {
    if (request.method !== "GET") throw new HttpError(405, "Method not allowed.");
    return json({ data: await listRecordsByType(env, "GPU_PAYOUT") }, 200, corsHeaders);
  }
  const match = path.match(/^\/v1\/hyperscaler\/payouts\/([^/]+)\/(processing|paid|failed)$/);
  if (!match || request.method !== "POST") throw new HttpError(404, "Hyperscaler payout route was not found.");
  const payout = await readRecord(env, decodeURIComponent(match[1]));
  const updated = transitionPayout(payout, match[2], await readOptionalJson(request));
  const earningIds = Array.isArray(payout?.earningIds) ? payout.earningIds : [];
  if (earningIds.length === 0) throw new HttpError(409, "Payout has no earning records and cannot be settled.");
  const earnings = await Promise.all(earningIds.map((id: string) => readRecord(env, id)));
  if (earnings.some((earning) => !earning)) throw new HttpError(409, "One or more payout earning records are missing.");
  const verifiedEarnings = earnings as CapacityRecord[];
  for (const earning of verifiedEarnings) {
    if (earning.recordType !== "GPU_EARNING" || earning.providerId !== payout.providerId || earning.currency !== payout.currency) throw new HttpError(409, "A payout earning record does not match the payout owner or currency.");
    if (earning.payoutId !== payout.id || earning.status !== "PAYOUT_PENDING") throw new HttpError(409, "A payout earning record is no longer reserved for this payout.");
  }
  const earningAmount = roundMoney(verifiedEarnings.reduce((total, earning) => total + Number(earning.netAmount ?? 0), 0));
  if (earningAmount !== roundMoney(Number(payout.amount))) throw new HttpError(409, "Payout amount does not match its earning records.");
  const updatedEarnings = verifiedEarnings.map((earning) => ({ ...earning, status: updated.status === "PAID" ? "PAID" : updated.status === "FAILED" ? "AVAILABLE" : "PAYOUT_PENDING", payoutId: updated.status === "FAILED" ? null : payout.id, paidAt: updated.status === "PAID" ? updated.paidAt : earning.paidAt, updatedAt: new Date().toISOString(), revision: Number(earning.revision ?? 0) + 1 }));
  const updatedEarningIds: string[] = [];
  try {
    for (const earning of updatedEarnings) {
      const original = earnings.find((candidate) => candidate.id === earning.id);
      await saveRecordWithRevision(env, earning, original?.revision);
      updatedEarningIds.push(earning.id);
    }
    await saveRecordWithRevision(env, updated, payout.revision);
  } catch (error) {
    const originalsById = new Map(verifiedEarnings.map((earning) => [earning.id, earning]));
    await Promise.allSettled(updatedEarningIds.map(async (earningId) => {
      const current = await readRecord(env, earningId);
      const original = originalsById.get(earningId);
      if (current && original) await saveRecordWithRevision(env, original, current.revision);
    }));
    throw error;
  }
  return json({ data: updated }, 200, corsHeaders);
}

async function handleHyperscalerPayoutProfileRoute(request: Request, path: string, env: Env, corsHeaders: HeadersInit) {
  const match = path.match(/^\/v1\/hyperscaler\/payout-profiles\/([^/]+)\/(verify|reject)$/);
  if (!match || request.method !== "POST") throw new HttpError(404, "Hyperscaler payout profile route was not found.");
  const profile = await readRecord(env, `payout-profile:${decodeURIComponent(match[1])}`);
  if (!profile) throw new HttpError(404, "Payout profile was not found.");
  const body = await readOptionalJson(request);
  const updated = { ...profile, status: match[2] === "verify" ? "VERIFIED" : "REJECTED", verificationReference: normalizeOptionalString(body.verificationReference), rejectionReason: match[2] === "reject" ? normalizeOptionalString(body.reason) : undefined, updatedAt: new Date().toISOString(), revision: Number(profile.revision ?? 0) + 1 };
  await saveRecordWithRevision(env, updated, profile.revision);
  return json({ data: updated }, 200, corsHeaders);
}

async function handleGpuListingRoute(request: Request, listingRoute: { id: string; action?: string }, user: JwtPayload, env: Env, corsHeaders: HeadersInit) {
  const existing = await readRecord(env, listingRoute.id);
  if (!existing || existing.recordType !== "GPU_CAPACITY") throw new HttpError(404, "GPU capacity listing was not found.");
  if (existing.ownerId !== user.sub) throw new HttpError(403, "Only the listing owner can change this GPU capacity.");
  if (request.method === "GET" && !listingRoute.action) return json({ data: existing }, 200, corsHeaders);
  if (request.method === "PUT" && !listingRoute.action) {
    const body = await request.json<Record<string, unknown>>();
    await assertWorkerListingCompatible(env, { ...existing, ...body }, body.workerNodeId ?? existing.workerNodeId, user.sub);
    await assertListingUpdateSafe(env, existing, body);
    const updated = validateGpuCapacitySubmission({ ...existing, ...body }, { id: existing.id, ownerId: existing.ownerId, ownerDisplayName: existing.ownerDisplayName, status: String(body.status ?? existing.status), createdAt: existing.createdAt, revision: Number(existing.revision ?? 0) + 1 }, { platformFeeBps: existing.platformFeeBps ?? platformFeeBps(env) });
    await saveRecordWithRevision(env, updated, existing.revision);
    return json({ data: updated }, 200, corsHeaders);
  }
  if (request.method === "POST" && listingRoute.action === "publish") {
    await assertWorkerListingCompatible(env, existing, existing.workerNodeId, user.sub);
    const updated = validateGpuCapacitySubmission({ ...existing, status: "PUBLISHED" }, { id: existing.id, ownerId: existing.ownerId, ownerDisplayName: existing.ownerDisplayName, status: "PUBLISHED", createdAt: existing.createdAt, revision: Number(existing.revision ?? 0) + 1 }, { platformFeeBps: existing.platformFeeBps ?? platformFeeBps(env) });
    await saveRecordWithRevision(env, updated, existing.revision);
    return json({ data: updated }, 200, corsHeaders);
  }
  if (request.method === "POST" && listingRoute.action === "pause") {
    const updated = { ...existing, status: "PAUSED", updatedAt: new Date().toISOString(), revision: Number(existing.revision ?? 0) + 1 };
    await saveRecordWithRevision(env, updated, existing.revision);
    return json({ data: updated }, 200, corsHeaders);
  }
  if (request.method === "POST" && listingRoute.action === "heartbeat") {
    if (existing.workerNodeId) throw new HttpError(409, "Master-managed listings must be updated through the provider node heartbeat endpoint.");
    const body = await readOptionalJson(request);
    const availableGpuCount = body.availableGpuCount === undefined ? existing.availableGpuCount : requirePositiveInteger(body.availableGpuCount, "availableGpuCount", { allowZero: true });
    if (availableGpuCount > existing.gpuCount) throw new HttpError(400, "availableGpuCount cannot exceed gpuCount.");
    const updated = { ...existing, availableGpuCount, lastHeartbeatAt: new Date().toISOString(), runtimeStatus: normalizeOptionalString(body.runtimeStatus) ?? existing.runtimeStatus, updatedAt: new Date().toISOString(), revision: Number(existing.revision ?? 0) + 1 };
    await saveRecordWithRevision(env, updated, existing.revision);
    return json({ data: updated }, 200, corsHeaders);
  }
  throw new HttpError(405, "Method not allowed.");
}

async function reserveCapacity(env: Env, listing: CapacityRecord, reservation: CapacityRecord) {
  const latestListing = await readRecord(env, listing.id);
  const latestNode = await readRecord(env, reservation.nodeId);
  if (!latestListing || latestListing.status !== "PUBLISHED" || Number(latestListing.availableGpuCount) < reservation.gpuCount) {
    throw new HttpError(409, "GPU listing capacity changed concurrently. Refresh and retry.", "CAPACITY_CONFLICT");
  }
  if (!latestNode || latestNode.status !== "ACTIVE" || latestNode.healthStatus !== "READY" || Number(latestNode.availableGpuCount) < reservation.gpuCount || !latestNode.lastHeartbeatAt || Date.parse(latestNode.lastHeartbeatAt) < Date.now() - heartbeatMaximumAgeSeconds(env) * 1000) {
    throw new HttpError(409, "Provider worker capacity changed concurrently. Refresh and retry.", "CAPACITY_CONFLICT");
  }
  const updatedListing = { ...latestListing, availableGpuCount: latestListing.availableGpuCount - reservation.gpuCount, updatedAt: reservation.createdAt, revision: Number(latestListing.revision ?? 0) + 1 };
  const updatedNode = { ...latestNode, availableGpuCount: latestNode.availableGpuCount - reservation.gpuCount, reservedGpuCount: Number(latestNode.reservedGpuCount ?? 0) + reservation.gpuCount, updatedAt: reservation.createdAt, revision: Number(latestNode.revision ?? 0) + 1 };
  let listingSaved = false;
  let nodeSaved = false;
  await saveRecord(env, reservation, true);
  try {
    await saveRecordWithRevision(env, updatedListing, latestListing.revision);
    listingSaved = true;
    await saveRecordWithRevision(env, updatedNode, latestNode.revision);
    nodeSaved = true;
  } catch (error) {
    const rollbacks: Promise<unknown>[] = [];
    if (listingSaved) rollbacks.push(saveRecordWithRevision(env, latestListing, updatedListing.revision));
    if (nodeSaved) rollbacks.push(saveRecordWithRevision(env, latestNode, updatedNode.revision));
    await Promise.allSettled(rollbacks);
    await deleteRecord(env, reservation.id);
    throw error;
  }
}

async function finalizeReservation(env: Env, previous: CapacityRecord, updated: CapacityRecord, options: { createEarningRecord?: boolean } = {}) {
  if (previous.capacityReleasedAt) throw new HttpError(409, "Reservation capacity was already released.");
  const timestamp = new Date().toISOString();
  const finalized = { ...updated, capacityReleasedAt: timestamp, updatedAt: timestamp };
  const listing = await readRecord(env, previous.listingId);
  const node = await readRecord(env, previous.nodeId);
  if (!listing || !node) throw new HttpError(409, "Reservation listing or provider node no longer exists.");
  if (Number(node.reservedGpuCount ?? 0) < previous.gpuCount) throw new HttpError(409, "Provider node reservation accounting is inconsistent.");
  const releasedListing = { ...listing, availableGpuCount: Math.min(listing.gpuCount, listing.availableGpuCount + previous.gpuCount), updatedAt: timestamp, revision: Number(listing.revision ?? 0) + 1 };
  const previousReservedGpuCount = Number(node.reservedGpuCount ?? 0);
  const nextReservedGpuCount = previousReservedGpuCount - previous.gpuCount;
  const reportedAvailableGpuCount = Number.isInteger(Number(node.reportedAvailableGpuCount))
    ? Number(node.reportedAvailableGpuCount)
    : Math.min(Number(node.gpuCount), Number(node.availableGpuCount ?? 0) + previousReservedGpuCount);
  const releasedNode = {
    ...node,
    reservedGpuCount: nextReservedGpuCount,
    availableGpuCount: calculateEffectiveAvailableGpuCount(Number(node.gpuCount), reportedAvailableGpuCount, nextReservedGpuCount),
    updatedAt: timestamp,
    revision: Number(node.revision ?? 0) + 1
  };
  const earning = options.createEarningRecord === false ? undefined : createEarning(finalized, { id: `earning:${finalized.id}` }, { holdSeconds: earningsHoldSeconds(env) });
  let earningSaved = false;
  let listingSaved = false;
  let nodeSaved = false;
  let reservationSaved = false;
  try {
    if (earning) {
      await saveRecord(env, earning, true);
      earningSaved = true;
    }
    await saveRecordWithRevision(env, releasedListing, listing.revision);
    listingSaved = true;
    await saveRecordWithRevision(env, releasedNode, node.revision);
    nodeSaved = true;
    await saveRecordWithRevision(env, finalized, previous.revision);
    reservationSaved = true;
  } catch (error) {
    const rollbacks: Promise<unknown>[] = [];
    if (reservationSaved) rollbacks.push(saveRecordWithRevision(env, previous, finalized.revision));
    if (nodeSaved) rollbacks.push(saveRecordWithRevision(env, node, releasedNode.revision));
    if (listingSaved) rollbacks.push(saveRecordWithRevision(env, listing, releasedListing.revision));
    await Promise.allSettled(rollbacks);
    if (earningSaved && earning) await deleteRecord(env, earning.id);
    throw error;
  }
  return finalized;
}

async function synchronizeListingsFromNode(env: Env, node: CapacityRecord) {
  const records = await listCapacityRecords(env);
  const listings = records.filter((record) => record.recordType === "GPU_CAPACITY" && record.workerNodeId === node.id);
  await Promise.allSettled(listings.map((listing) => {
    const updated = { ...listing, lastHeartbeatAt: node.lastHeartbeatAt, runtimeStatus: node.healthStatus, endpointUrl: node.endpointUrl ?? listing.endpointUrl, updatedAt: new Date().toISOString(), revision: Number(listing.revision ?? 0) + 1 };
    return saveRecordWithRevision(env, updated, listing.revision);
  }));
}

async function persistDisputedReservation(env: Env, previous: CapacityRecord, disputed: CapacityRecord) {
  const earning = await readRecord(env, `earning:${previous.id}`);
  if (!earning) {
    await saveRecordWithRevision(env, disputed, previous.revision);
    return disputed;
  }
  if (["PAYOUT_PENDING", "PAID"].includes(earning.status) || earning.payoutId) {
    throw new HttpError(409, "This reservation earning is already in settlement and must be escalated manually.");
  }
  const heldEarning = {
    ...earning,
    status: "HELD",
    updatedAt: disputed.updatedAt,
    revision: Number(earning.revision ?? 0) + 1
  };
  await saveRecordWithRevision(env, heldEarning, earning.revision);
  try {
    await saveRecordWithRevision(env, disputed, previous.revision);
  } catch (error) {
    await Promise.allSettled([saveRecordWithRevision(env, earning, heldEarning.revision)]);
    throw error;
  }
  return disputed;
}

async function persistMaterializedEarnings(env: Env, stored: CapacityRecord[], materialized: CapacityRecord[]) {
  const storedById = new Map(stored.map((earning) => [earning.id, earning]));
  await Promise.allSettled(materialized
    .filter((earning) => storedById.get(earning.id)?.status !== earning.status)
    .map((earning) => saveRecordWithRevision(env, earning, storedById.get(earning.id)?.revision)));
}

async function hasActiveReservationsForNode(env: Env, nodeId: string) {
  return (await listRecordsByType(env, "GPU_RESERVATION")).some((reservation) => reservation.nodeId === nodeId && ["ASSIGNED", "ACCEPTED", "RUNNING"].includes(reservation.status));
}

async function assertListingUpdateSafe(env: Env, existing: CapacityRecord, body: Record<string, unknown>) {
  const activeReservations = (await listRecordsByType(env, "GPU_RESERVATION")).filter((reservation) => reservation.listingId === existing.id && ["ASSIGNED", "ACCEPTED", "RUNNING"].includes(reservation.status));
  if (activeReservations.length === 0) return;
  const immutableFields = ["workerNodeId", "gpuCount", "availableGpuCount", "allocationMode", "pricePerGpuHour", "currency"];
  const changedField = immutableFields.find((field) => body[field] !== undefined && body[field] !== existing[field]);
  if (changedField) throw new HttpError(409, `${changedField} cannot be changed while the listing has active reservations.`);
  const reservedGpuCount = activeReservations.reduce((total, reservation) => total + Number(reservation.gpuCount ?? 0), 0);
  if (body.availableGpuCount !== undefined && Number(body.availableGpuCount) > Number(existing.gpuCount) - reservedGpuCount) throw new HttpError(409, "availableGpuCount cannot include GPUs reserved by active assignments.");
}

async function expireStaleAssignmentsForNode(env: Env, nodeId: string) {
  const now = new Date();
  const stale = (await listRecordsByType(env, "GPU_RESERVATION")).filter((reservation) => reservation.nodeId === nodeId && reservation.status === "ASSIGNED" && Date.parse(reservation.assignmentExpiresAt) <= now.getTime());
  let expiredCount = 0;
  for (const reservation of stale) {
    const latest = await readRecord(env, reservation.id);
    if (!latest || latest.status !== "ASSIGNED") continue;
    const expired = transitionReservation(latest, "expire", {}, { now });
    await finalizeReservation(env, latest, expired, { createEarningRecord: false });
    expiredCount += 1;
  }
  return expiredCount;
}

async function expireAllStaleAssignments(env: Env) {
  const nodeIds = [...new Set((await listRecordsByType(env, "GPU_RESERVATION")).filter((reservation) => reservation.status === "ASSIGNED" && Date.parse(reservation.assignmentExpiresAt) <= Date.now()).map((reservation) => String(reservation.nodeId)))];
  let expiredCount = 0;
  for (const nodeId of nodeIds) expiredCount += await expireStaleAssignmentsForNode(env, nodeId);
  return { expiredCount, checkedNodeCount: nodeIds.length, sweptAt: new Date().toISOString() };
}

function requireEventuallyConsistentAllocationOptIn(env: Env) {
  if (String(env.CAPACITY_ALLOW_EVENTUALLY_CONSISTENT_ALLOCATIONS ?? "").toLowerCase() !== "true") {
    throw new HttpError(503, "Cloudflare KV cannot guarantee transactional GPU allocation or payout settlement. Use the AWS API as the hyperscaler master, or explicitly set CAPACITY_ALLOW_EVENTUALLY_CONSISTENT_ALLOCATIONS=true after accepting the overbooking and double-settlement risk.", "TRANSACTIONAL_COORDINATOR_REQUIRED");
  }
}

function projectPublicListing(listing: CapacityRecord, node: CapacityRecord | undefined, env: Env) {
  if (listing.workerNodeId) {
    if (!node || node.status !== "ACTIVE" || node.healthStatus !== "READY") return undefined;
    if (!node.lastHeartbeatAt || Date.parse(node.lastHeartbeatAt) < Date.now() - heartbeatMaximumAgeSeconds(env) * 1000) return undefined;
  }
  const { endpointUrl, providerInstructions, checkoutUrl, latitude, longitude, workerNodeId, ...publicListing } = listing;
  return {
    ...publicListing,
    availableGpuCount: node ? Math.max(0, Math.min(Number(listing.availableGpuCount ?? 0), Number(node.availableGpuCount ?? 0))) : publicListing.availableGpuCount,
    endpointAvailableAfterReservation: Boolean(endpointUrl || listing.workerNodeId),
    nodeHealthStatus: node?.healthStatus,
    lastHeartbeatAt: node?.lastHeartbeatAt ?? listing.lastHeartbeatAt
  };
}

function projectProviderReservation(reservation: CapacityRecord) {
  const { fundingReference, ...providerReservation } = reservation;
  return providerReservation;
}

function projectNodeAssignment(reservation: CapacityRecord) {
  return {
    id: reservation.id,
    listingId: reservation.listingId,
    status: reservation.status,
    gpuCount: reservation.gpuCount,
    requestedHours: reservation.requestedHours,
    workloadReference: reservation.workloadReference,
    workloadKind: reservation.workloadKind,
    workloadMetadata: reservation.workloadMetadata,
    assignmentExpiresAt: reservation.assignmentExpiresAt,
    pricePerGpuHour: reservation.pricePerGpuHour,
    currency: reservation.currency,
    providerAuthorizedAmount: reservation.providerAuthorizedAmount,
    createdAt: reservation.createdAt,
    updatedAt: reservation.updatedAt
  };
}

async function assertOwnedWorkerNode(env: Env, workerNodeId: unknown, ownerId: string) {
  if (!workerNodeId) return undefined;
  const node = await readRecord(env, String(workerNodeId));
  if (!node || node.recordType !== "GPU_PROVIDER_NODE") throw new HttpError(400, "workerNodeId does not identify a registered provider node.");
  if (node.ownerId !== ownerId) throw new HttpError(403, "workerNodeId belongs to another provider.");
  if (node.status === "DISABLED") throw new HttpError(409, "The selected worker node is disabled.");
  return node;
}

async function assertWorkerListingCompatible(env: Env, submission: Record<string, unknown>, workerNodeId: unknown, ownerId: string) {
  const node = await assertOwnedWorkerNode(env, workerNodeId, ownerId);
  if (!node) return;
  const gpuModel = String(submission.gpuModel ?? "").trim().toLowerCase();
  if (gpuModel && gpuModel !== String(node.gpuModel ?? "").trim().toLowerCase()) throw new HttpError(409, "The listing GPU model must match the registered worker node.");
  const gpuCount = Number(submission.gpuCount);
  if (Number.isFinite(gpuCount) && gpuCount > Number(node.gpuCount ?? 0)) throw new HttpError(409, "The listing cannot advertise more GPUs than the registered worker node owns.");
  const allocationMode = String(submission.allocationMode ?? "").trim().toUpperCase();
  if (allocationMode && (!Array.isArray(node.allocationModes) || !node.allocationModes.includes(allocationMode))) throw new HttpError(409, `The worker node does not support ${allocationMode} allocation.`);
}

async function authenticateNode(authorization: string | null, expectedNodeId: string, env: Env) {
  if (!authorization?.startsWith("Node ")) throw new HttpError(401, "A provider node token is required.");
  const credential = authorization.slice("Node ".length).trim();
  const separatorIndex = credential.indexOf(".");
  const nodeId = separatorIndex > 0 ? credential.slice(0, separatorIndex) : "";
  if (!nodeId || nodeId !== expectedNodeId) throw new HttpError(401, "Provider node token did not match the requested node.");
  const node = await readRecord(env, nodeId);
  if (!node || node.recordType !== "GPU_PROVIDER_NODE" || node.status === "DISABLED") throw new HttpError(401, "Provider node token is not active.");
  if (!constantTimeEqual(await sha256Hex(credential), String(node.tokenHash ?? ""))) throw new HttpError(401, "Provider node token was rejected.");
  return node;
}

function matchNodeControlRoute(path: string) {
  let match = path.match(/^\/v1\/provider\/nodes\/([^/]+)\/(heartbeat|assignments)$/);
  if (match) return { nodeId: decodeURIComponent(match[1]), action: match[2], reservationId: undefined, assignmentAction: undefined };
  match = path.match(/^\/v1\/provider\/nodes\/([^/]+)\/assignments\/([^/]+)\/(accept|start|usage|complete|fail)$/);
  if (match) return { nodeId: decodeURIComponent(match[1]), action: "assignments", reservationId: decodeURIComponent(match[2]), assignmentAction: match[3] };
  return undefined;
}

function matchGpuCapacityListingRoute(path: string) {
  const match = path.match(/^\/v1\/capacity\/gpu\/([^/]+)(?:\/(publish|pause|heartbeat))?$/);
  return match ? { id: decodeURIComponent(match[1]), action: match[2] } : undefined;
}

async function listCapacityRecords(env: Env) {
  const registry = requireCapacityRegistry(env);
  const prefixes = ["capacity-record:", "gpu-capacity:"];
  const records: CapacityRecord[] = [];
  for (const prefix of prefixes) {
    let cursor: string | undefined;
    do {
      const result = await registry.list({ prefix, cursor });
      const values = await Promise.all(result.keys.map(async (key) => {
        const value = await registry.get(key.name);
        return value ? JSON.parse(value) as CapacityRecord : undefined;
      }));
      records.push(...values.filter((record): record is CapacityRecord => Boolean(record)));
      cursor = result.list_complete ? undefined : result.cursor;
    } while (cursor);
  }
  return [...new Map(records.map((record) => [record.id, record])).values()].sort((left, right) => String(right.updatedAt ?? "").localeCompare(String(left.updatedAt ?? "")));
}

async function listRecordsByType(env: Env, recordType: string) {
  return (await listCapacityRecords(env)).filter((record) => record.recordType === recordType);
}

async function readRecord(env: Env, id: string) {
  if (!id) return undefined;
  const registry = requireCapacityRegistry(env);
  const value = await registry.get(`capacity-record:${id}`) ?? await registry.get(`gpu-capacity:${id}`);
  return value ? JSON.parse(value) as CapacityRecord : undefined;
}

async function saveRecord(env: Env, record: CapacityRecord, requireNew: boolean) {
  const registry = requireCapacityRegistry(env);
  if (requireNew && await readRecord(env, record.id)) throw new HttpError(409, "A capacity record with that id already exists.");
  await registry.put(`capacity-record:${record.id}`, JSON.stringify(record));
  if (record.recordType === "GPU_CAPACITY") await registry.delete(`gpu-capacity:${record.id}`);
}

async function saveRecordWithRevision(env: Env, record: CapacityRecord, expectedRevision: number) {
  const existing = await readRecord(env, record.id);
  if (!existing || Number(existing.revision ?? 1) !== Number(expectedRevision ?? 1)) throw new HttpError(409, "The capacity record changed concurrently. Refresh and retry.", "CAPACITY_CONFLICT");
  await saveRecord(env, record, false);
}

async function deleteRecord(env: Env, id: string) {
  const registry = requireCapacityRegistry(env);
  await registry.delete(`capacity-record:${id}`);
  await registry.delete(`gpu-capacity:${id}`);
}

function requireCapacityRegistry(env: Env) {
  if (!env.GPU_CAPACITY_REGISTRY) throw new HttpError(503, "GPU capacity storage is not configured. Bind GPU_CAPACITY_REGISTRY.");
  return env.GPU_CAPACITY_REGISTRY;
}

function createSecret() {
  return `${crypto.randomUUID().replaceAll("-", "")}${crypto.randomUUID().replaceAll("-", "")}`;
}

async function sha256Hex(value: string) {
  const digest = await crypto.subtle.digest("SHA-256", new TextEncoder().encode(value));
  return [...new Uint8Array(digest)].map((byte) => byte.toString(16).padStart(2, "0")).join("");
}

function constantTimeEqual(left: string, right: string) {
  if (left.length !== right.length) return false;
  let difference = 0;
  for (let index = 0; index < left.length; index += 1) difference |= left.charCodeAt(index) ^ right.charCodeAt(index);
  return difference === 0;
}

function heartbeatMaximumAgeSeconds(env: Env) { return integerEnvironmentValue(env.CAPACITY_HEARTBEAT_MAX_AGE_SECONDS, 120, 30, 3600); }
function assignmentTimeoutSeconds(env: Env) { return integerEnvironmentValue(env.CAPACITY_ASSIGNMENT_TIMEOUT_SECONDS, 300, 30, 3600); }
function earningsHoldSeconds(env: Env) { return integerEnvironmentValue(env.CAPACITY_EARNINGS_HOLD_SECONDS, 604800, 0, 2592000); }
function platformFeeBps(env: Env) { return integerEnvironmentValue(env.CAPACITY_PLATFORM_FEE_BPS, 1000, 0, 5000); }
function minimumPayoutAmount(env: Env) { const value = Number(env.CAPACITY_MINIMUM_PAYOUT_AMOUNT ?? 25); return Number.isFinite(value) && value >= 0 ? value : 25; }
function integerEnvironmentValue(rawValue: string | undefined, fallback: number, minimum: number, maximum: number) { const value = Number(rawValue ?? fallback); return Number.isInteger(value) && value >= minimum && value <= maximum ? value : fallback; }

async function authenticate(request: Request, env: Env): Promise<JwtPayload> {
  const authorization = request.headers.get("authorization");
  if (!authorization?.startsWith("Bearer ")) throw new HttpError(401, "A bearer access token is required.");
  const token = authorization.slice("Bearer ".length);
  const parts = token.split(".");
  if (parts.length !== 3) throw new HttpError(401, "Malformed access token.");
  const header = decodeJson<JwtHeader>(parts[0]);
  const payload = decodeJson<JwtPayload>(parts[1]);
  if (header.alg !== "RS256") throw new HttpError(401, `Unsupported token algorithm ${header.alg}.`);
  const issuer = env.AUTH_ISSUER.replace(/\/$/, "");
  if (payload.iss.replace(/\/$/, "") !== issuer) throw new HttpError(401, "Token issuer did not match.");
  if (payload.token_use && payload.token_use !== "access") throw new HttpError(401, "An access token is required.");
  const expectedClientIds = env.AUTH_AUDIENCE.split(",").map((value) => value.trim()).filter(Boolean);
  const presentedClientId = typeof payload.client_id === "string" ? payload.client_id : typeof payload.azp === "string" ? payload.azp : undefined;
  if (!presentedClientId || !expectedClientIds.includes(presentedClientId)) throw new HttpError(401, "Token was issued for a different Cognito app client. Sign out and sign in again.");
  const now = Math.floor(Date.now() / 1000);
  if (payload.exp <= now) throw new HttpError(401, "Access token has expired.");
  if (payload.nbf && payload.nbf > now + 30) throw new HttpError(401, "Access token is not active yet.");
  const metadata = await getMetadata(issuer);
  const keys = await getJwks(metadata.jwks_uri);
  const key = keys.find((candidate) => candidate.kid === header.kid && candidate.kty === "RSA");
  if (!key) throw new HttpError(401, "Token signing key was not found.");
  const cryptoKey = await crypto.subtle.importKey("jwk", key, { name: "RSASSA-PKCS1-v1_5", hash: "SHA-256" }, false, ["verify"]);
  const valid = await crypto.subtle.verify("RSASSA-PKCS1-v1_5", cryptoKey, decodeBase64Url(parts[2]), new TextEncoder().encode(`${parts[0]}.${parts[1]}`));
  if (!valid) throw new HttpError(401, "Access token signature was invalid.");
  return payload;
}

async function getMetadata(issuer: string) {
  const cached = metadataCache.get(issuer);
  if (cached && cached.expiresAt > Date.now()) return cached.value;
  const response = await fetch(`${issuer}/.well-known/openid-configuration`);
  if (!response.ok) throw new HttpError(503, "Identity provider discovery failed.");
  const value = await response.json<OidcMetadata>();
  metadataCache.set(issuer, { value, expiresAt: Date.now() + 60 * 60 * 1000 });
  return value;
}

async function getJwks(jwksUri: string) {
  const cached = jwksCache.get(jwksUri);
  if (cached && cached.expiresAt > Date.now()) return cached.value;
  const response = await fetch(jwksUri);
  if (!response.ok) throw new HttpError(503, "Identity provider signing keys could not be loaded.");
  const value = await response.json<{ keys: JwkWithKid[] }>();
  jwksCache.set(jwksUri, { value: value.keys, expiresAt: Date.now() + 15 * 60 * 1000 });
  return value.keys;
}

async function listGateways(env: Env) {
  const builtIn = [
    { id: "huggingface", name: "Hugging Face", schemes: ["hf"], capabilities: ["resolve", "download", "auth"] },
    { id: "direct", name: "Direct HTTPS", schemes: ["http", "https"], capabilities: ["resolve", "download"] },
    { id: "ollama", name: "Ollama Registry", schemes: ["ollama"], capabilities: ["resolve", "native-pull"] }
  ];
  if (!env.GATEWAY_REGISTRY) return builtIn;
  const keys = await env.GATEWAY_REGISTRY.list({ prefix: "gateway:" });
  const contributed = await Promise.all(keys.keys.map(async (key) => JSON.parse((await env.GATEWAY_REGISTRY!.get(key.name)) ?? "null")));
  return [...builtIn, ...contributed.filter(Boolean)];
}

function validateGatewaySubmission(input: unknown) {
  if (!input || typeof input !== "object") throw new HttpError(400, "Gateway submission must be an object.");
  const value = input as Record<string, unknown>;
  const id = requireString(value.id, "id");
  const name = requireString(value.name, "name");
  const packageName = requireString(value.packageName, "packageName");
  const repository = requireString(value.repository, "repository");
  if (!/^[a-z0-9][a-z0-9._-]*$/.test(id)) throw new HttpError(400, "Gateway id is invalid.");
  if (!packageName.includes("openmodel-gateway")) throw new HttpError(400, "Gateway package name must clearly identify itself as an OpenModel gateway.");
  return { id, name, packageName, repository, apiVersion: 1, submittedAt: new Date().toISOString() };
}

function userDisplayName(user: JwtPayload) { return String(user.name ?? user.username ?? user["cognito:username"] ?? user.email ?? "OpenModel provider"); }
function hasPermission(payload: JwtPayload, permission: string) { const permissions = Array.isArray(payload.permissions) ? payload.permissions : []; const scopes = String(payload.scope ?? "").split(/\s+/).filter(Boolean); return permissions.includes(permission) || scopes.some((scope) => scope === permission || scope.endsWith(`/${permission}`)); }
function hasHyperscalerPermission(payload: JwtPayload, env: Env, permission = "capacity:master") { if (hasPermission(payload, permission) || hasPermission(payload, "capacity:master")) return true; const groups = Array.isArray(payload["cognito:groups"]) ? payload["cognito:groups"].map((value) => String(value).toLowerCase()) : []; if (groups.includes("hyperscalers") || groups.includes("capacity-masters")) return true; return String(env.HYPERSCALER_SUBJECTS ?? "").split(",").map((value) => value.trim()).filter(Boolean).includes(payload.sub); }
function requirePermission(payload: JwtPayload, permission: string) { if (!hasPermission(payload, permission)) throw new HttpError(403, `Permission ${permission} is required.`); }
function requireHyperscaler(payload: JwtPayload, env: Env, permission = "capacity:master") { if (!hasHyperscalerPermission(payload, env, permission)) throw new HttpError(403, `Hyperscaler master permission ${permission} is required.`); }
function requireString(value: unknown, field: string) { if (typeof value !== "string" || value.trim().length === 0) throw new HttpError(400, `${field} is required.`); return value.trim(); }
function requirePositiveInteger(value: unknown, field: string, options: { allowZero?: boolean } = {}) { const numericValue = Number(value); const minimum = options.allowZero ? 0 : 1; if (!Number.isInteger(numericValue) || numericValue < minimum) throw new HttpError(400, `${field} must be an integer greater than or equal to ${minimum}.`); return numericValue; }
function normalizeOptionalString(value: unknown) { if (value === undefined || value === null) return undefined; const normalized = String(value).trim(); return normalized || undefined; }
async function readOptionalJson(request: Request) { const text = await request.text(); if (!text) return {} as Record<string, any>; try { return JSON.parse(text) as Record<string, any>; } catch { throw new HttpError(400, "The request body must contain valid JSON."); } }
function createCorsHeaders(origin: string | null, value: string) { const defaultOrigins = ["https://openmodel.sh", "https://www.openmodel.sh", "https://walton.bot", "https://www.walton.bot"]; const allowed = [...new Set([...value.split(",").map((entry) => entry.trim()).filter(Boolean), ...defaultOrigins])]; const resolved = origin && allowed.includes(origin) ? origin : allowed[0] ?? "*"; return { "access-control-allow-origin": resolved, "access-control-allow-headers": "authorization, content-type, idempotency-key", "access-control-allow-methods": "GET, POST, PUT, OPTIONS", vary: "Origin" }; }
function normalizePath(path: string) { return path.length > 1 && path.endsWith("/") ? path.slice(0, -1) : path; }
function json(body: unknown, status: number, headers: HeadersInit = {}) { return new Response(JSON.stringify(body), { status, headers: { "content-type": "application/json; charset=utf-8", ...headers } }); }
function decodeJson<T>(value: string): T { try { return JSON.parse(new TextDecoder().decode(decodeBase64Url(value))) as T; } catch { throw new HttpError(401, "Malformed access token payload."); } }
function decodeBase64Url(value: string) { const padded = value.replace(/-/g, "+").replace(/_/g, "/").padEnd(Math.ceil(value.length / 4) * 4, "="); const binary = atob(padded); return Uint8Array.from(binary, (character) => character.charCodeAt(0)); }
class HttpError extends Error { status: number; code?: string; constructor(status: number, message: string, code?: string) { super(message); this.status = status; this.code = code; } }
